# Copy to .env and adjust. Everything is optional; with no .env it runs paper
# crypto on free Binance data.

# ---- Web server (localhost only, no auth; keep it local) --------------------
PORT=8787
HOST=127.0.0.1

# With EXECUTION=alpaca the Alpaca account is the fund and STARTING_CAPITAL is ignored.
# Optionally cap how much of the account the agents may use (0 = all of it).
ALPACA_CAPITAL_CAP=0

# ---- Paper fund -------------------------------------------------------------
STARTING_CAPITAL=10000
# Crypto are bare tickers. Prefix stocks with $, e.g. BTC,ETH,SOL,$NVDA,$AAPL
# Stocks require Alpaca keys (below).
SYMBOLS=BTC,ETH,SOL
# TIMEFRAME_STOCK / TIMEFRAME_CRYPTO set a different candle size per asset class (default: TIMEFRAME).
# 5m | 15m | 1h | 4h | 1d. Slower candles trade less often, so fees and spread eat less of each move.
TIMEFRAME=15m

# Market data: auto | binance | coinbase | alpaca | sim
# "auto" uses Binance for crypto; stocks always come from Alpaca.
DATA_PROVIDER=auto

# Execution venue: paper (simulated fills) | alpaca (real paper/live account)
# Keep this "paper" until the Real Money License checklist is green.
EXECUTION=paper

# Fill realism for EXECUTION=paper
FEE_RATE=0.001
SLIPPAGE_BPS=3

# ---- Coin database (optional) -------------------------------------------------
# A free CoinGecko demo key (coingecko.com/en/api) lifts lookups from ~5 to 30 per minute.
COINGECKO_API_KEY=

# ---- Explorer (finds lower-cap crypto and stocks beyond SYMBOLS) -------------
SCAN_ENABLED=true
# Minutes between scans, how many off-the-map markets to keep, and how many to add per scan
SCAN_INTERVAL_MIN=30
SCAN_MAX_EXPLORED=10
SCAN_ADD_PER_SCAN=3
# Crypto: 24h dollar-volume band, and market-cap rank/size filter (CoinGecko, no key needed)
SCAN_MIN_VOLUME_USD=2000000
SCAN_MAX_VOLUME_USD=150000000
SCAN_SKIP_TOP_RANK=50
SCAN_MIN_MCAP_USD=10000000
# Stocks come from Alpaca's screener and need the Alpaca keys below
SCAN_STOCKS=true
SCAN_STOCK_MIN_PRICE=1
SCAN_STOCK_MAX_PRICE=60
# Drop an explored market after this many research epochs without a strategy
SCAN_EVICT_AFTER_EPOCHS=4

# ---- OKX (EXECUTION=okx; the demo account only) ----------------------------------
# Create a demo API key under Demo Trading > Personal Center > Demo Trading API, with Read and
# Trade permissions only. Put the values in .env, never in this file.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true

# PROFILE=aggressive loosens risk limits and adds leverage (paper only; see npm run hi).
PROFILE=
LEVERAGE=2

# ---- Agents -----------------------------------------------------------------
RESEARCHERS=4
TRADERS=6
RESEARCH_CPU=0.35

# ---- LLM (Prof. Quill strategist + the news desk) ---------------------------
# Needs an API key. "openai" works with any OpenAI-compatible endpoint.
# anthropic | openai
LLM_PROVIDER=
LLM_API_KEY=
# Main model (strategy design). Default: claude-sonnet-4-5 / gpt-4o-mini
LLM_MODEL=
# Cheap model for high-frequency news tagging. Default: claude-3-5-haiku-latest
LLM_FAST_MODEL=
LLM_BASE_URL=
# Minutes between strategist brainstorms
LLM_INTERVAL_MIN=30
# USD per 1M tokens, for the cost meter and budget (defaults match the models above)
LLM_PRICE_IN=
LLM_PRICE_OUT=
# Hard daily spend cap. The LLM sleeps for the day when this is hit. 0 = no cap.
LLM_DAILY_BUDGET_USD=1
# If LLM-attributed P&L trails its cost over this many days, it pauses itself.
LLM_EARN_WINDOW_DAYS=7

# ---- News desk --------------------------------------------------------------
NEWS_ENABLED=true
NEWS_POLL_MIN=8
# Headlines batched into one LLM call (keeps cost down)
NEWS_BATCH=12
# How long a news signal stays live, minutes (also capped by the LLM's horizon)
NEWS_SIGNAL_TTL_MIN=180
# Comma-separated RSS/Atom feeds
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed

# ---- Alpaca (data for stocks, and real paper/live execution) ----------------
# Paper keys from the Alpaca dashboard (Paper Trading toggle). Keys stay local.
ALPACA_KEY_ID=
ALPACA_SECRET=
# true = paper endpoint, false = live. Endpoints are chosen automatically.
ALPACA_PAPER=true
# Optional overrides (leave blank to use Alpaca defaults)
ALPACA_TRADING_URL=
ALPACA_DATA_URL=

DATA_DIR=./data
