{
  "name": "ai-trader-valley",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent paper-trading ecosystem with a pixel-art village UI",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "report": "tsx server/report.ts",
    "niche": "tsx server/niche.ts",
    "hi": "tsx server/hiact.ts",
    "daily": "tsx server/daily.ts",
    "approve-live": "tsx server/approve-live.ts",
    "coin": "tsx server/coin.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
